{
  "openapi": "3.1.0",
  "info": {
    "title": "LexLoom API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "Process is running. Never touches dependencies.\n\nConflating this with readiness is the classic cause of a supervisor\nkilling a healthy process during a transient database blip.",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "Dependencies are reachable.",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Jwks",
        "operationId": "jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Jwks"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/demo-login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Demo Login",
        "description": "Mint a throwaway organisation for this visitor.\n\nShared demo orgs would put one visitor's upload in front of the next, and a\nproject whose headline claim is per-org isolation cannot seat every visitor\nin the same tenant. An ephemeral org makes the demo demonstrate the thesis:\ntwo browsers, two orgs, mutually invisible data.\n\n`expires_in` describes the token, so it is the same constant the token was\nminted with — not a second literal that agrees with `mint()`'s default by\ncoincidence and stops agreeing the moment either is tuned.",
        "operationId": "demo_login_api_v1_auth_demo_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoLoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Conversation",
        "operationId": "create_conversation_api_v1_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateConversationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{conversation_id}/messages": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Message",
        "description": "Accept the question and return immediately.\n\nGeneration happens on the stream endpoint, not here. Answering 202 rather\nthan holding the request open is what lets the client open the stream on\nits own terms — and it keeps this handler off the critical path of a slow\nprovider.",
        "operationId": "create_message_api_v1_conversations__conversation_id__messages_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/stream-tickets": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Stream Ticket",
        "description": "Mint the credential an EventSource can carry in its URL.\n\nThe message id is not checked for existence here. A ticket is only ever\nhonoured by the stream endpoint, which looks the message up in the ticket\nholder's own tenant context — so a ticket for someone else's message id, or\nfor none at all, buys a 404 and nothing more. Checking here would add an\nexistence oracle in exchange for nothing.",
        "operationId": "create_stream_ticket_api_v1_auth_stream_tickets_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamTicketResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{conversation_id}/messages/{message_id}/stream": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "Stream Message",
        "operationId": "stream_message_api_v1_conversations__conversation_id__messages__message_id__stream_get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Message Id"
            }
          },
          {
            "name": "ticket",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticket"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Get Status",
        "operationId": "get_status_api_v1_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/generators": {
      "get": {
        "tags": [
          "generators"
        ],
        "summary": "List Generators",
        "operationId": "list_generators_api_v1_generators_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratorsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateConversationRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CreateConversationRequest"
      },
      "CreateConversationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "CreateConversationResponse"
      },
      "CreateMessageRequest": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          },
          "generator": {
            "$ref": "#/components/schemas/GeneratorChoice",
            "default": "deterministic"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "CreateMessageRequest"
      },
      "CreateMessageResponse": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          }
        },
        "type": "object",
        "required": [
          "message_id"
        ],
        "title": "CreateMessageResponse"
      },
      "DemoLoginRequest": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "DemoLoginRequest"
      },
      "DemoLoginResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "org_name": {
            "type": "string",
            "title": "Org Name"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "org_id",
          "org_name",
          "expires_in"
        ],
        "title": "DemoLoginResponse"
      },
      "GeneratorChoice": {
        "type": "string",
        "enum": [
          "deterministic",
          "gemini-3.5-flash-lite",
          "gemini-3.6-flash"
        ],
        "title": "GeneratorChoice",
        "description": "Which `LLMProvider` a request asked for.\n\nRead on the `POST /messages` request body and stored on the row (migration\n0005's `generator` column); `stream_message` reads it back and hands it to\n`build_provider`. The value that comes back out is also what the\n`message_start` SSE frame carries as `model` — see `app.chat.stream`.\n\nThe two Gemini members carry the model id as their value rather than a\nshort label like the old `GEMINI` member did: `build_provider` below reads\nthe model straight off `choice.value`, so there is exactly one place that\nknows the mapping from a visitor's choice to a Gemini model name, and it\nis this enum. A short label plus a separate lookup table would be two\nthings that have to agree with each other and nothing enforcing it."
      },
      "GeneratorOption": {
        "properties": {
          "value": {
            "$ref": "#/components/schemas/GeneratorChoice"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "title": "GeneratorOption"
      },
      "GeneratorsResponse": {
        "properties": {
          "generators": {
            "items": {
              "$ref": "#/components/schemas/GeneratorOption"
            },
            "type": "array",
            "title": "Generators"
          }
        },
        "type": "object",
        "required": [
          "generators"
        ],
        "title": "GeneratorsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Jwks": {
        "properties": {
          "keys": {
            "items": {
              "$ref": "#/components/schemas/JwksKey"
            },
            "type": "array",
            "title": "Keys"
          }
        },
        "type": "object",
        "required": [
          "keys"
        ],
        "title": "Jwks"
      },
      "JwksKey": {
        "properties": {
          "kty": {
            "type": "string",
            "title": "Kty"
          },
          "use": {
            "type": "string",
            "title": "Use"
          },
          "alg": {
            "type": "string",
            "title": "Alg"
          },
          "kid": {
            "type": "string",
            "title": "Kid"
          },
          "n": {
            "type": "string",
            "title": "N"
          },
          "e": {
            "type": "string",
            "title": "E"
          }
        },
        "type": "object",
        "required": [
          "kty",
          "use",
          "alg",
          "kid",
          "n",
          "e"
        ],
        "title": "JwksKey",
        "description": "One RSA public key, in the six members RFC 7517 needs to verify with.\n\nNamed rather than left as `dict[str, str]` so the *absence* of the private\nmembers is visible in the schema. `d`, `p` and `q` are not here, and a\nresponse model drops anything not declared — so if a future key source ever\nhanded them over, this endpoint would not pass them on."
      },
      "Percentiles": {
        "properties": {
          "p50_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "P50 Ms"
          },
          "p95_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "P95 Ms"
          },
          "p99_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "P99 Ms"
          },
          "samples": {
            "type": "integer",
            "title": "Samples"
          },
          "above_ms": {
            "type": "integer",
            "title": "Above Ms"
          },
          "above_count": {
            "type": "integer",
            "title": "Above Count"
          }
        },
        "type": "object",
        "required": [
          "p50_ms",
          "p95_ms",
          "p99_ms",
          "samples",
          "above_ms",
          "above_count"
        ],
        "title": "Percentiles"
      },
      "RequestCounts": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "by_class": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Class"
          }
        },
        "type": "object",
        "required": [
          "total",
          "by_class"
        ],
        "title": "RequestCounts"
      },
      "ServiceStatus": {
        "properties": {
          "commit": {
            "type": "string",
            "title": "Commit"
          },
          "uptime_seconds": {
            "type": "integer",
            "title": "Uptime Seconds"
          },
          "window_seconds": {
            "type": "integer",
            "title": "Window Seconds"
          },
          "requests": {
            "$ref": "#/components/schemas/RequestCounts"
          },
          "time_to_response_start": {
            "$ref": "#/components/schemas/Percentiles",
            "description": "Time from the start of request handling to the response status line, over every route except the SSE stream, this endpoint and the health probes."
          },
          "stream_duration": {
            "$ref": "#/components/schemas/Percentiles",
            "description": "How long SSE streams stayed open. Not a latency: it is mostly the model."
          }
        },
        "type": "object",
        "required": [
          "commit",
          "uptime_seconds",
          "window_seconds",
          "requests",
          "time_to_response_start",
          "stream_duration"
        ],
        "title": "ServiceStatus"
      },
      "StreamTicketRequest": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          }
        },
        "type": "object",
        "required": [
          "message_id"
        ],
        "title": "StreamTicketRequest"
      },
      "StreamTicketResponse": {
        "properties": {
          "ticket": {
            "type": "string",
            "title": "Ticket"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "ticket",
          "expires_in"
        ],
        "title": "StreamTicketResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
