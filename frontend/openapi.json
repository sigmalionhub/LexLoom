      }
    },
    "/api/v1/auth/demo-login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Demo Login",
        "description": "Mint a throwaway organisation for this visitor.\n\nShared demo orgs would put one visitor's upload in front of the next, and a\nproject whose headline claim is per-org isolation cannot seat every visitor\nin the same tenant. An ephemeral org makes the demo demonstrate the thesis:\ntwo browsers, two orgs, mutually invisible data.\n\n`expires_in` describes the token, so it is the same constant the token was\nminted with \u2014 not a second literal that agrees with `mint()`'s default by\ncoincidence and stops agreeing the moment either is tuned.",
        "operationId": "demo_login_api_v1_auth_demo_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoLoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
