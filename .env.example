ENV=local
MIGRATOR_DB_PASSWORD=migrator
APP_DB_PASSWORD=app
WORKER_DB_PASSWORD=worker
ERROR_TYPE_BASE_URL=http://localhost:8100

# Admission control (backend/app/limits.py). Every one of these has a working
# default; they are listed because the defaults are sized for the deployment in
# deploy/README.md and a different box wants different numbers.
#
# Addresses and CIDRs whose X-Forwarded-For is believed. docker-compose.yml
# already widens this to the Compose bridge range, which is where nginx's
# forwarded connection appears to come from inside the container. Set it here
# only to override that.
# TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Throwaway tenants one address may create per window. Each costs 31 rows and
# ~11.7 kB, so 30/hour bounds one address at ~8 MB across the 24-hour purge
# cycle. A visitor needs one; two demonstrate the isolation thesis.
# DEMO_LOGIN_LIMIT=30
# DEMO_LOGIN_WINDOW_SECONDS=3600

# Concurrent SSE streams, in total and per organisation. 16 leaves four of the
# 20 pooled database connections for everything that is not a stream.
# MAX_CONCURRENT_STREAMS=16
# MAX_CONCURRENT_STREAMS_PER_ORG=4

# Off is how the test suite runs. `Settings` refuses to construct with this
# false when ENV=production, so setting it here cannot reach the demo box.
# LIMITS_ENABLED=true
