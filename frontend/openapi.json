      }
    },
    "/api/v1/conversations/{conversation_id}/messages": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Message",
        "description": "Accept the question and return immediately.\n\nGeneration happens on the stream endpoint, not here. Answering 202 rather\nthan holding the request open is what lets the client open the stream on\nits own terms \u2014 and it keeps this handler off the critical path of a slow\nprovider.",
        "operationId": "create_message_api_v1_conversations__conversation_id__messages_post",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/stream-tickets": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Stream Ticket",
        "description": "Mint the credential an EventSource can carry in its URL.\n\nThe message id is not checked for existence here. A ticket is only ever\nhonoured by the stream endpoint, which looks the message up in the ticket\nholder's own tenant context \u2014 so a ticket for someone else's message id, or\nfor none at all, buys a 404 and nothing more. Checking here would add an\nexistence oracle in exchange for nothing.",
        "operationId": "create_stream_ticket_api_v1_auth_stream_tickets_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamTicketResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{conversation_id}/messages/{message_id}/stream": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "Stream Message",
        "operationId": "stream_message_api_v1_conversations__conversation_id__messages__message_id__stream_get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Message Id"
            }
          },
          {
            "name": "ticket",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticket"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Get Status",
        "operationId": "get_status_api_v1_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/generators": {
      "get": {
        "tags": [
          "generators"
        ],
        "summary": "List Generators",
        "operationId": "list_generators_api_v1_generators_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratorsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogue": {
      "get": {
        "tags": [
          "ingest"
        ],
        "summary": "Get Catalogue",
        "description": "The documents this deployment can ingest.\n\nThis route did not exist while the catalogue held one document, and the\nmodule docstring above used to argue against adding one: a route built for\na single caller and a single value is the same mistake as a `job_id` nobody\nreads. With a second source the panel has to render a list it cannot know in\nadvance, and hard-coding the pair in the frontend would put the catalogue in\ntwo places that drift.\n\nUnauthenticated, for the reason `GET /api/v1/generators` gives for itself:\nit takes no token, sees no organisation and reads no org-scoped table, so it\ncarries none of the residual-purge argument migration 0004 makes for a\ncredential. What it exposes is what a `/docs` reader already sees in the\nschema \u2014 which documents exist \u2014 and not one field about where they live on\ndisk or how they were built.\n\nOrdered as `CATALOGUE` is ordered, which is insertion order and therefore\nstable across runs: the panel renders the list as it arrives, and a set-like\niteration would reshuffle the visitor's rows between polls.",
        "operationId": "get_catalogue_api_v1_catalogue_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CatalogueEntry"
                  },
                  "type": "array",
                  "title": "Response Get Catalogue Api V1 Catalogue Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Start Ingest",
        "description": "Admit, queue and dispatch \u2014 in that order, and none of it skipped on\na race. `ensure_ingest_admitted` raises `ProblemError` for both ceilings\n(409 already_ingested, 503 capacity_unavailable with Retry-After); a\ncatalogue miss is checked first, cheaply, before either touches\nPostgres.",
        "operationId": "start_ingest_api_v1_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest/status": {
      "get": {
        "tags": [
          "ingest"
        ],
        "summary": "Get Ingest Status",
        "description": "Every catalogue source's status for this organisation, keyed by source.\n\nA map rather than one status, and rather than a `?source_key=` parameter,\nbecause the panel polls this twice a second while anything is in flight: one\nrequest describing the whole catalogue costs what one source used to, where\na parameterised route would cost one request per document. The exclusion in\n`app/observability.py`'s `_NOT_MEASURED` was granted on that poll rate and\nstill holds for the same reason.\n\nEvery key in the catalogue appears, whether or not this tenant has touched\nit \u2014 a source the tenant has never ingested reports `idle`. A caller that\nhad to distinguish \"absent from the map\" from \"not started\" would be\ndeciding something the server already knows.",
        "operationId": "get_ingest_status_api_v1_ingest_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/IngestStatusResponse"
                  },
                  "type": "object",
                  "title": "Response Get Ingest Status Api V1 Ingest Status Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/evals": {
      "get": {
        "tags": [
          "evals"
        ],
        "summary": "Read Evals",
        "operationId": "read_evals_api_v1_evals_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvalsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogueEntry": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "preloaded": {
            "type": "boolean",
            "title": "Preloaded",
            "description": "True when every tenant is given this document at sign-in rather than ingesting it. The page draws the two differently and says which happened, and it cannot infer this: a preloaded document and one ingested an hour ago both read `complete`. Derived from `PRELOADED_SOURCE_KEYS`, so the frontend never spells a source key."
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggestions",
            "description": "Questions the page offers once a tenant holds this document. May be empty. They travel with the catalogue rather than living in the frontend for the same reason this route exists: a question is a property of the document, and a copy in the page would drift from the corpus that has to answer it."
          }
        },
        "type": "object",
        "required": [
          "key",
          "title",
          "media_type",
          "preloaded",
          "suggestions"
        ],
        "title": "CatalogueEntry",
        "description": "What a caller may know about a source: five fields, and no more.\n\n`Source` (`app/ingest/catalogue.py`) also carries `path`, `sha256`,\n`document_xml_sha256` and `conversion`. None of them leave the server.\n`path` is an absolute path inside the image, and `conversion` names the\nbuild tool and its exact version \u2014 neither is any of a visitor's business,\nand a response model that listed the dataclass's fields by default would\nhave shipped both. The model is the boundary, not a convenience."
      },
      "CreateConversationRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CreateConversationRequest"
      },
      "CreateConversationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "CreateConversationResponse"
      },
      "CreateMessageRequest": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          },
          "generator": {
            "$ref": "#/components/schemas/GeneratorChoice",
            "default": "deterministic"
          },
          "mode": {
            "$ref": "#/components/schemas/SearchMode",
            "default": "fts"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "CreateMessageRequest"
      },
      "CreateMessageResponse": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          }
        },
        "type": "object",
        "required": [
          "message_id"
        ],
        "title": "CreateMessageResponse"
      },
      "DemoLoginRequest": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "DemoLoginRequest"
      },
      "DemoLoginResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "org_name": {
            "type": "string",
            "title": "Org Name"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "org_id",
          "org_name",
          "expires_in"
        ],
        "title": "DemoLoginResponse"
      },
      "EvalsCorpus": {
        "properties": {
          "sources": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Sources"
          },
          "chunks": {
            "type": "integer",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "sources",
          "chunks"
        ],
        "title": "EvalsCorpus",
        "description": "What was searched. `sources` maps a catalogue key to its chunk count."
      },
      "EvalsModeMetrics": {
        "properties": {
          "precision_at_3": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precision At 3"
          },
          "recall_at_5": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recall At 5"
          },
          "mrr_at_10": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mrr At 10"
          },
          "ndcg_at_10": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ndcg At 10"
          },
          "answerability_auc": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answerability Auc"
          },
          "by_kind": {
            "additionalProperties": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "type": "object",
            "title": "By Kind"
          }
        },
        "type": "object",
        "title": "EvalsModeMetrics",
        "description": "One mode's five numbers, plus the same four again split by question kind.\n\nEvery metric is optional because `None` is a real answer and zero is not:\nrecall, reciprocal rank and nDCG are undefined on a question with no relevant\nchunk, and `answerability_auc` is undefined when every top-1 score is equal.\nReporting 0.0 there would be a claim of failure where there is no\nmeasurement."
      },
      "EvalsProvenance": {
        "properties": {
          "goldset_sha256": {
            "type": "string",
            "title": "Goldset Sha256"
          },
          "corpus_fingerprint": {
            "type": "string",
            "title": "Corpus Fingerprint"
          },
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "modes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Modes"
          }
        },
        "type": "object",
        "required": [
          "goldset_sha256",
          "corpus_fingerprint",
          "embedding_model",
          "limit",
          "modes"
        ],
        "title": "EvalsProvenance",
        "description": "What the numbers are about \u2014 the fields the CI freshness check compares.\n\n`goldset_sha256` and `corpus_fingerprint` are hashes of the questions and of\nthe parsed corpus, so a build whose gold set or catalogue has moved on cannot\nquietly keep publishing the old measurement under a fresh-looking date."
      },
      "EvalsQuestions": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "answerable": {
            "type": "integer",
            "title": "Answerable"
          },
          "unanswerable": {
            "type": "integer",
            "title": "Unanswerable"
          }
        },
        "type": "object",
        "required": [
          "total",
          "answerable",
          "unanswerable"
        ],
        "title": "EvalsQuestions",
        "description": "Thirty questions, six of which have no answer in the corpus *by design*.\n\nThe split is in the payload rather than left to the reader because without\nit `precision_at_3 = 0.18` invites the reading \"82% broken\", when a fifth of\nthe set is asking for a miss."
      },
      "EvalsResponse": {
        "properties": {
          "schema": {
            "type": "integer",
            "title": "Schema"
          },
          "measured_at": {
            "type": "string",
            "title": "Measured At"
          },
          "commit": {
            "type": "string",
            "title": "Commit"
          },
          "provenance": {
            "$ref": "#/components/schemas/EvalsProvenance"
          },
          "corpus": {
            "$ref": "#/components/schemas/EvalsCorpus"
          },
          "questions": {
            "$ref": "#/components/schemas/EvalsQuestions"
          },
          "modes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/EvalsModeMetrics"
            },
            "type": "object",
            "title": "Modes"
          }
        },
        "type": "object",
        "required": [
          "schema",
          "measured_at",
          "commit",
          "provenance",
          "corpus",
          "questions",
          "modes"
        ],
        "title": "EvalsResponse",
        "description": "The stored artefact. `measured_at` and `commit` say when and on what.\n\nBoth matter more than usual here: this is the one endpoint whose body was\ncomputed long before the request, so a reader who cannot see its age cannot\ntell a current measurement from a stale one."
      },
      "GeneratorChoice": {
        "type": "string",
        "enum": [
          "deterministic",
          "gemini-3.5-flash-lite",
          "gemini-3.6-flash"
        ],
        "title": "GeneratorChoice",
        "description": "Which `LLMProvider` a request asked for.\n\nRead on the `POST /messages` request body and stored on the row (migration\n0005's `generator` column); `stream_message` reads it back and hands it to\n`build_provider`. The value that comes back out is also what the\n`message_start` SSE frame carries as `model` \u2014 see `app.chat.stream`.\n\nThe two Gemini members carry the model id as their value rather than a\nshort label like the old `GEMINI` member did: `build_provider` below reads\nthe model straight off `choice.value`, so there is exactly one place that\nknows the mapping from a visitor's choice to a Gemini model name, and it\nis this enum. A short label plus a separate lookup table would be two\nthings that have to agree with each other and nothing enforcing it."
      },
      "GeneratorOption": {
        "properties": {
          "value": {
            "$ref": "#/components/schemas/GeneratorChoice"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
