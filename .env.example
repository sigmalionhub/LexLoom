# local | ci | demo | production
#
# `demo` is what the public box in deploy/README.md runs, and it is a real
# value rather than a label: it turns on everything a box the internet can
# reach must have — the demo-login rate limit and the stream ceilings become
# mandatory, and the JWKS URL must be HTTPS — while still permitting the
# development identity provider, which refuses to start under `production`.
#
# `production` is reserved for a deployment behind a real identity provider.
# Setting it here does not work and is not meant to: `create_app()` refuses to
# start the dev IdP under it.
ENV=local

MIGRATOR_DB_PASSWORD=migrator
APP_DB_PASSWORD=app
WORKER_DB_PASSWORD=worker
ERROR_TYPE_BASE_URL=http://localhost:8100

# Redis AUTH. Interpolated into both `--requirepass` and every service's
# REDIS_URL by docker-compose.yml, so the server and its clients cannot disagree
# about it, and read by nothing in the application itself.
#
# **Required to be changed when ENV=demo.** The value below is committed in this
# repository, so it is not a secret; it is here so a clean checkout's `docker
# compose up` and `pytest` both work without a setup step. On a box the public
# can reach, `app/redis_auth.py` refuses to start any process still using it —
# the same treatment `Settings` gives the placeholder proxy secret, and for the
# same reason: a default that authenticates is worse than one that does not,
# because it works. Generate a real one with `openssl rand -hex 32`.
#
# Why AUTH at all when the port is on 127.0.0.1: because the deployment host is
# shared, and every local account on it reaches host loopback. That is the same
# fact TRUSTED_PROXY_SECRET below exists for. Without a password, a neighbouring
# process reads live organisation ids straight out of the progress and
# stream-slot keys — and an organisation id is the RLS credential.
REDIS_PASSWORD=lexloom-local-redis

# Google AI Studio key for the Gemini generator option (backend/app/chat/gemini.py).
# Empty is a working state: without it, `build_provider(GeneratorChoice.GEMINI)`
# refuses rather than silently answering with the fake generator, and the demo
# runs on the deterministic one alone; GET /api/v1/generators lists which
# choices would actually work. Forwarded to the `api` service only — the worker
# and beat never generate an answer, so `docker inspect` on either shows nothing
# worth reading to anyone else in the `docker` group on this shared box.
GEMINI_API_KEY=

# Where the API fetches the key set it verifies its own tokens against.
# **Required to be HTTPS when ENV=demo**, so the deployment points it at the
# public origin, which nginx proxies straight back to the container.
# AUTH_JWKS_URL=https://lexloom.sigmalion.io/.well-known/jwks.json

# --- The embedding model (backend/app/chat/embedding.py) ---------------------
#
# There is no variable here, and the absence is the documentation.
# `sentence-transformers/all-MiniLM-L6-v2` at 384 dimensions is not a setting:
# `document_chunks.embedding` is `Vector(384)` (migration 0002), so a model of
# any other width fails at INSERT with an error naming neither the model nor
# the column, and moving off it would mean moving the column, every stored
# vector and the eval baselines together.
#
# The weights live at FASTEMBED_CACHE_PATH, which backend/Dockerfile sets to
# /home/lexloom/.cache/fastembed and fills during the build, so a container
# never reaches the network for them. Setting that path in this file would do
# nothing — Compose does not forward it, and the image already carries it —
# which is precisely the dead-knob shape the block below exists to prevent.
# Running the backend outside a container, the code defaults to
# ~/.cache/fastembed and downloads ~90 MB once.

# --- Admission control (backend/app/limits.py) -------------------------------
#
# Every one of these has a working default; they are listed because the
# defaults are sized for the deployment in deploy/README.md and a different box
# wants different numbers.

# Addresses and CIDRs whose X-Forwarded-For is believed, or the word `none` to
# read the header from nobody. docker-compose.yml already widens this to the
# Compose bridge range, which is where nginx's forwarded connection appears to
# come from inside the container. An empty value and a zero-length prefix
# (0.0.0.0/0) are both refused — they are the two silent ways to get this
# wrong, in opposite directions.
# TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Proves a request came *through* nginx rather than merely from its direction.
# Being on the bridge network is not evidence: every connection through the
# published port arrives from the gateway, including one forged by a
# server-side request forgery in another application on this shared box.
#
# **Required when ENV=demo** unless TRUSTED_PROXIES=none. Generate one, put it
# here, and put the same value in the `X-LexLoom-Proxy` line of the installed
# copy of deploy/nginx/snippets/lexloom-proxy.conf:
#
#     openssl rand -hex 32
#
# TRUSTED_PROXY_SECRET=

# Throwaway tenants one address may create per window. One call writes **1009
# rows** — an organisation plus the 1008 chunks every tenant is born holding
# (backend/app/ingest/preload.py) — and 1.95 MiB of Postgres heap, measured on
# the deployment. The hourly purge collects only tenants whose 24-hour TTL has
# already lapsed, so an address spending 30 an hour holds 720 live tenants and
# ~1.4 GiB before anything is reclaimed. The arithmetic, and what it does and
# does not press against, is worked out in backend/app/config.py beside the
# default. A visitor needs one tenant; two demonstrate the isolation thesis.
# DEMO_LOGIN_LIMIT=30
# DEMO_LOGIN_WINDOW_SECONDS=3600

# Concurrent SSE streams, in total and per organisation. 16 leaves four of the
# 20 pooled database connections for everything that is not a stream.
# MAX_CONCURRENT_STREAMS=16
# MAX_CONCURRENT_STREAMS_PER_ORG=4

# How long a stream slot may go without a sign of life before the sweep
# reclaims it. **Not** a cap on how long a stream may run — nothing caps that,
# and a running stream refreshes its own slot every 150 s. This is the backstop
# for a process that died holding one, so 600 leaves four keepalive intervals
# of slack over the refresh period. Lower it and a live stream on a loaded box
# can have its slot collected out from under it, which admits one more stream
# than the ceiling allows.
# STREAM_SLOT_TTL_SECONDS=600

# Off is how the test suite runs, and Compose forwards this, so it is a real
# knob. It cannot silently disarm a public box: `Settings` refuses to construct
# with this false when ENV is `demo` or `production`, so the container fails to
# start rather than starting unmetered. The process also reports which way it
# is set, once, at start-up.
# LIMITS_ENABLED=true

# --- Ingest admission control (backend/app/ingest/jobs.py) -------------------
#
# How many organisations may hold an ingested corpus from the catalogue
# (backend/app/ingest/catalogue.py) at once — the seed corpus every
# organisation gets at login does not count. Enforced by the SECURITY DEFINER
# public.reserve_ingest_slot() (migration 0008), called from the API before a
# task is queued: the slot is *reserved* there rather than inferred from
# committed corpora, because nothing commits during admission and a burst
# therefore walked straight through the ceiling. 16 x ~1.37 MB per tenant is
# ~22 MB of Postgres, on a container limited to 384 MB, and it doubles as the
# bound on how far an ingest backlog can push back the hourly demo-org purge —
# both tasks share one queue and one worker (docker-compose.yml).
# INGEST_ORG_CAP=16
