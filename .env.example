# local | ci | demo | production
#
# `demo` is what the public box in deploy/README.md runs, and it is a real
# value rather than a label: it turns on everything a box the internet can
# reach must have — the demo-login rate limit and the stream ceilings become
# mandatory, and the JWKS URL must be HTTPS — while still permitting the
# development identity provider, which refuses to start under `production`.
#
# `production` is reserved for a deployment behind a real identity provider.
# Setting it here does not work and is not meant to: `create_app()` refuses to
# start the dev IdP under it.
ENV=local

MIGRATOR_DB_PASSWORD=migrator
APP_DB_PASSWORD=app
WORKER_DB_PASSWORD=worker
ERROR_TYPE_BASE_URL=http://localhost:8100

# Where the API fetches the key set it verifies its own tokens against.
# **Required to be HTTPS when ENV=demo**, so the deployment points it at the
# public origin, which nginx proxies straight back to the container.
# AUTH_JWKS_URL=https://lexloom.sigmalion.io/.well-known/jwks.json

# --- Admission control (backend/app/limits.py) -------------------------------
#
# Every one of these has a working default; they are listed because the
# defaults are sized for the deployment in deploy/README.md and a different box
# wants different numbers.

# Addresses and CIDRs whose X-Forwarded-For is believed, or the word `none` to
# read the header from nobody. docker-compose.yml already widens this to the
# Compose bridge range, which is where nginx's forwarded connection appears to
# come from inside the container. An empty value and a zero-length prefix
# (0.0.0.0/0) are both refused — they are the two silent ways to get this
# wrong, in opposite directions.
# TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Proves a request came *through* nginx rather than merely from its direction.
# Being on the bridge network is not evidence: every connection through the
# published port arrives from the gateway, including one forged by a
# server-side request forgery in another application on this shared box.
#
# **Required when ENV=demo** unless TRUSTED_PROXIES=none. Generate one, put it
# here, and put the same value in the `X-LexLoom-Proxy` line of the installed
# copy of deploy/nginx/snippets/lexloom-proxy.conf:
#
#     openssl rand -hex 32
#
# TRUSTED_PROXY_SECRET=

# Throwaway tenants one address may create per window. Each costs 31 rows and
# ~11.7 kB, so 30/hour bounds one address at ~8 MB across the 24-hour purge
# cycle. A visitor needs one; two demonstrate the isolation thesis.
# DEMO_LOGIN_LIMIT=30
# DEMO_LOGIN_WINDOW_SECONDS=3600

# Concurrent SSE streams, in total and per organisation. 16 leaves four of the
# 20 pooled database connections for everything that is not a stream.
# MAX_CONCURRENT_STREAMS=16
# MAX_CONCURRENT_STREAMS_PER_ORG=4

# Off is how the test suite runs, and Compose forwards this, so it is a real
# knob. It cannot silently disarm a public box: `Settings` refuses to construct
# with this false when ENV is `demo` or `production`, so the container fails to
# start rather than starting unmetered. The process also reports which way it
# is set, once, at start-up.
# LIMITS_ENABLED=true
